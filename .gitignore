# The tool ships as-is -- index.html, styles.css and js/ are the deployed site,
# with nothing to build. Everything ignored here belongs to the test tooling, or
# is local scratch and editor droppings.

# Encoder output dumped for external validation with ffprobe / avifdec /
# webpinfo / pngcheck. The test corpus itself under corpus/ IS committed —
# it is the regression suite, and it is a few kilobytes of hand-made GIFs.
out/

# JetBrains IDE config
.idea/

# macOS
.DS_Store

# Personal, machine-specific Claude Code settings (pins gh to the immanuelqrw
# account for this repo). Never committed -- the path is local to one machine.
.claude/settings.local.json

# Test tooling
node_modules/
playwright-report/
test-results/
.venv/

# Python bytecode, from running the corpus generator
__pycache__/
